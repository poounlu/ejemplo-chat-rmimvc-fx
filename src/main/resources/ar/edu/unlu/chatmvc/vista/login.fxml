<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ar.edu.unlu.chatmvc.vista.LoginController"
      alignment="CENTER" spacing="16.0" prefWidth="360.0" prefHeight="260.0">
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
    </padding>

    <Label text="Chat MVC" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
    <Label text="Ingresá tu nombre de usuario para comenzar:" />

    <TextField fx:id="txtUsuario" promptText="Nombre de usuario" maxWidth="240.0" onAction="#onIniciar" />
    <Button fx:id="btnIniciar" text="Ingresar al chat" defaultButton="true" onAction="#onIniciar" maxWidth="240.0" />
</VBox>
